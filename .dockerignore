# The venv is built for this laptop's Python and architecture. Never ship it.
.venv/
__pycache__/
*.pyc

.git/
.gitignore

# Rebuilt inside the container or mounted at run time.
data/chroma/
data/papers/
.logs/
training/out/
training/data/
# Papers are large PDFs — re-ingested at deploy time, not baked into the image.
curricula/*/papers/

# Local only.
Pictures/
*.docx
.env

# Dev feature flags — must NEVER ship. Holds auth_required:false in dev, which
# disables auth for the whole deployment. Prod falls back to settings.py
# DEFAULTS (auth_required: True).
settings.json
