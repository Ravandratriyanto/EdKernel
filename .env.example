# Template only — this file IS committed and pushed. Never put a real key here.
# Copy it to .env (which is gitignored) and fill the values in there instead.
# Any key left blank in .env can still be typed into the UI.

# LLM provider key. Only needed when provider is not "ollama".
# Groq: https://console.groq.com/keys
API_KEY=

# Tavily search key, used by past-papers mode.
# https://app.tavily.com
TAVILY_KEY=
