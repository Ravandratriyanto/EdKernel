
# Template only — this file IS committed and pushed. Never put a real key here.
# Copy it to .env (which is gitignored) and fill the values in there instead.
# Any key left blank in .env can still be typed into the UI.

# LLM provider key. Only needed when provider is not "ollama".
# Groq: https://console.groq.com/keys
API_KEY=

# Tavily search key, used by past-papers mode.
# https://app.tavily.com
TAVILY_KEY=

# Set to 1 only when serving over https. It marks the login cookie Secure.
# Leave blank on localhost: a Secure cookie is silently dropped over plain
# http, so setting this without TLS looks like login is broken.
OLLM_HTTPS=

# Google sign-in (OAuth2). Create an OAuth client ID ("Web application") at
# https://console.cloud.google.com/apis/credentials and add the redirect URI
#   http://localhost:5000/auth/google/callback      (dev)
#   https://<your-domain>/auth/google/callback      (deployed — must be https)
# Leave blank to hide the Google button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: only allow accounts from one Google Workspace domain, e.g. myschool.sch.id
GOOGLE_ALLOWED_DOMAIN=
# Signs the short-lived OAuth state cookie. Any long random string; must be the
# same for every worker. python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=
# Set to 1 only when running behind the AWS load balancer (trusts X-Forwarded-*).
BEHIND_PROXY=
