#!/usr/bin/env bash
# Two checks, both blocking:
#
#   1. Live API keys in staged changes.
#   2. Python that will not parse.
#
# Three keys have leaked in three sessions (chat paste, .gitignore, .env.example),
# each time because a key was pasted into whichever file was nearest. Two of those
# files were tracked. This makes that a failed commit rather than a bad push.
#
# Scans ADDED lines only, so deleting a key from a file is never blocked.
# Bypass with `git commit --no-verify` if you ever genuinely need to.

set -uo pipefail

fail=0

# name<TAB>regex — anchored on the long random tail so short placeholders
# like placeholder="gsk_..." don't trip it.
PATTERNS=$'Groq\tgsk_[A-Za-z0-9]{20,}
Tavily\ttvly-(dev-)?[A-Za-z0-9_-]{20,}
OpenAI\tsk-(proj-)?[A-Za-z0-9_-]{20,}
AWS access key\tAKIA[0-9A-Z]{16}
Anthropic\tsk-ant-[A-Za-z0-9_-]{20,}'

# Added lines in the staged diff, minus the +++ file headers. May be empty on a
# delete-only commit; the loop below then matches nothing, which is correct.
added=$(git diff --cached --unified=0 | grep '^+' | grep -v '^+++' || true)

found=0
while IFS=$'\t' read -r name regex; do
    [[ -z "$name" ]] && continue
    if hits=$(printf '%s\n' "$added" | grep -Eo "$regex" | sort -u) && [[ -n "$hits" ]]; then
        if (( found == 0 )); then
            echo "COMMIT BLOCKED — live API key in staged changes:" >&2
            echo >&2
        fi
        found=1
        while IFS= read -r hit; do
            # Show only enough to identify which key, never the whole thing.
            echo "  $name: ${hit:0:8}...${hit: -4}" >&2
            # Name the file so it can actually be found.
            git diff --cached --name-only -S"$hit" | sed 's/^/    in /' >&2
        done <<< "$hits"
    fi
done <<< "$PATTERNS"

if (( found )); then
    cat >&2 <<'EOF'

Move the key into .env (gitignored) and leave the tracked file blank.
Treat any key that got this far as burned — rotate it, don't just move it.

Override with: git commit --no-verify
EOF
    fail=1
fi


# --- 2. Python syntax -------------------------------------------------------
#
# Seven sessions, seven of them with a typo that stopped a file importing.
#
# This catches 5 of the 11 bugs in users.py, not the 9 first claimed — measured,
# not guessed. It gets the merged `import timefrom`, a stray `.` in a path,
# `passwordL str`, an unmatched `)`, and a stray line-continuation backslash.
#
# It does NOT get the other 6, because they all parse fine:
#   sqlite3.row / conn.exceute      attribute typos, AttributeError at runtime
#   n = N, r = R  vs  _N, _R        undefined names, NameError at runtime
#   missing comma in a SQL string   sqlite is the only thing that can see it
#   a block dedented out of `with`  valid Python, just wrong
#   DB_PATH -> "logs" not ".logs"   valid Python, and untracked-vs-tracked
# A linter (pyflakes) would add the undefined-name case. Nothing here catches
# an attribute typo without running the code.
#
# Checks the STAGED content, not the file on disk. Staging a file and then
# editing it further is exactly when the two differ, and it is the staged
# version that gets committed.

root=$(git rev-parse --show-toplevel)
# Pick a working Python. Preference order: venv, then whichever command exists
# and actually runs. On Windows Git Bash `python3` and `python` sometimes point
# at different installs (Store stub vs real interpreter), so both need trying.
pick_python() {
    local cand
    for cand in \
        "$root/.venv/bin/python" \
        "$root/.venv/Scripts/python.exe" \
        python3 \
        python; do
        if [[ "$cand" == /* ]]; then
            [[ -x "$cand" ]] && "$cand" -c '' 2>/dev/null && { echo "$cand"; return; }
        else
            command -v "$cand" >/dev/null && "$cand" -c '' 2>/dev/null && { echo "$cand"; return; }
        fi
    done
}
py=$(pick_python)
if [[ -z "$py" ]]; then
    echo "warn: no working python found — pre-commit checks skipped" >&2
    exit 0
fi

syntax_bad=0
syntax_ok=()
# -z gives NUL-separated names, so a path with a space survives.
# ACMR = added, copied, modified, renamed — never deleted, which has no content.
while IFS= read -r -d '' path; do
    [[ "$path" == *.py ]] || continue
    if err=$(git show ":$path" | "$py" -c '
import sys
name = sys.argv[1]
try:
    compile(sys.stdin.read(), name, "exec")
except SyntaxError as e:
    print(f"  {name}:{e.lineno}: {e.msg}")
    if e.text:
        print("      " + e.text.rstrip())
        # e.offset is 1-based, and is 0 on some errors — clamp it.
        print("      " + " " * max((e.offset or 1) - 1, 0) + "^")
    sys.exit(1)
except ValueError as e:
    # Null bytes and similar — not a SyntaxError, still not importable.
    print(f"  {name}: {e}")
    sys.exit(1)
' "$path" 2>&1); then
        syntax_ok+=("$path")
    else
        if (( syntax_bad == 0 )); then
            echo "COMMIT BLOCKED — staged Python does not parse:" >&2
            echo >&2
        fi
        syntax_bad=1
        printf '%s\n' "$err" >&2
    fi
done < <(git diff --cached --name-only -z --diff-filter=ACMR)

if (( syntax_bad )); then
    cat >&2 <<'EOF'

This is the staged version, which is not always what is on disk. If you fixed
it already, `git add` the file again.

Override with: git commit --no-verify
EOF
    fail=1
fi


# --- 3. Pyflakes: undefined names and shadowed definitions ------------------
#
# The syntax check catches typos that stop a file parsing. It cannot catch a
# typo that still parses — `sqlite3.exeucte` or a lost `import`, which look
# fine to the compiler and fail only when the line runs. Pyflakes reads the
# same class of bug from the AST.
#
# Filtered to `undefined name` / `undefined local` / `redefinition of unused`.
# Pyflakes also flags unused imports and unused locals, both of which have real
# reasons to exist (re-exports, side-effect imports, work-in-progress code) and
# would block legitimate commits.
#
# The redefinition case is here because of Session 12: `_ollama_usage` was typed
# in twice, the new version above the original, and the second `def` silently
# replaced the first. No error, no warning, and the new code never ran — the
# conclusion would have been "the guard doesn't work" when it was never called.
# A second `def` of the same name in one file is nearly always that mistake.
#
# Skipped for files that failed the syntax check above, which pyflakes would
# just repeat. Skipped entirely when pyflakes isn't installed, with one warning.

# The Python we picked above may not have pyflakes even if some other Python on
# the box does — the two commands `python3` and `python` sometimes point at
# different installs. Try each candidate until we find one with pyflakes.
pyflakes_py=""
for cand in "$py" "$root/.venv/bin/python" "$root/.venv/Scripts/python.exe" python3 python; do
    [[ -z "$cand" ]] && continue
    "$cand" -c "import pyflakes" 2>/dev/null && { pyflakes_py="$cand"; break; }
done

if [[ -z "$pyflakes_py" ]]; then
    if (( ${#syntax_ok[@]} > 0 )); then
        echo "warn: pyflakes not installed — undefined-name check skipped (pip install pyflakes)" >&2
    fi
else
    lint_bad=0
    for path in "${syntax_ok[@]}"; do
        # pyflakes with no args reads stdin and labels it <stdin>; substitute
        # the real path back in so the message is grep-able and clickable.
        findings=$(git show ":$path" | "$pyflakes_py" -m pyflakes 2>&1 \
                   | grep -E 'undefined (name|local)|redefinition of unused' \
                   | sed "s|<stdin>|$path|g" || true)
        if [[ -n "$findings" ]]; then
            if (( lint_bad == 0 )); then
                echo "COMMIT BLOCKED — staged Python has undefined or shadowed names:" >&2
                echo >&2
            fi
            lint_bad=1
            printf '%s\n' "$findings" | sed 's/^/  /' >&2
        fi
    done

    if (( lint_bad )); then
        cat >&2 <<'EOF'

Fix the reference, add the missing import, or delete the duplicate definition,
then `git add` the file again.

Override with: git commit --no-verify
EOF
        fail=1
    fi
fi

exit "$fail"
